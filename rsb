def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rsb",
        description="RAPP Second Brain — local-first memory and records for AI agents.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Docs: https://github.com/kody-w/rapp-secondbrain",
    )
    parser.add_argument("--home", help="brain directory (default $RAPP_SECOND_BRAIN_HOME or ~/.rapp-second-brain)")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--actor", default="cli", help="who is writing (cli, jarvis, telegram, hotline...)")
    parser.add_argument("--version", action="version", version=f"rsb {__version__} ({SPEC})")
    subs = parser.add_subparsers(dest="command", required=True)

    init = subs.add_parser("init", help="create the brain")
    init.add_argument("--owner")
    init.set_defaults(func=cmd_init)

    # -- note ---------------------------------------------------------------
    note = subs.add_parser("note", help="durable facts (alias: remember)")
    note_subs = note.add_subparsers(dest="note_cmd", required=True)
    note_add = note_subs.add_parser("add")
    note_add.add_argument("text")
    note_add.add_argument("--tag", action="append")
    note_add.add_argument("--source")
    note_list = note_subs.add_parser("list")
    note_list.add_argument("query", nargs="?")
    note_list.add_argument("--tag", action="append")
    note_list.add_argument("--limit", type=int, default=20)
    note.set_defaults(func=cmd_note)

    remember = subs.add_parser("remember", help="shorthand for `note add`")
    remember.add_argument("text")
    remember.add_argument("--tag", action="append")
    remember.add_argument("--source")
    remember.set_defaults(func=cmd_note, note_cmd="add")

    # -- contact ------------------------------------------------------------
    contact = subs.add_parser("contact", help="people and places")
    contact_subs = contact.add_subparsers(dest="contact_cmd", required=True)
    contact_add = contact_subs.add_parser("add")
    contact_add.add_argument("--name", required=True)
    for flag in ("--phone", "--email", "--org", "--role", "--notes"):
        contact_add.add_argument(flag)
    contact_add.add_argument("--tag", action="append")
    contact_find = contact_subs.add_parser("find")
    contact_find.add_argument("query")
    contact_subs.add_parser("list")
    contact.set_defaults(func=cmd_contact)

    # -- call ---------------------------------------------------------------
    call = subs.add_parser("call", help="phone calls and transcripts")
    call_subs = call.add_subparsers(dest="call_cmd", required=True)
    call_start = call_subs.add_parser("start")
    call_start.add_argument("--to", required=True)
    call_start.add_argument("--direction", choices=["outbound", "inbound"], default="outbound")
    call_start.add_argument("--objective")
    call_start.add_argument("--constraint", action="append")
    call_start.add_argument("--provider", default="unknown")
    call_turn = call_subs.add_parser("turn")
    call_turn.add_argument("--call", required=True)
    call_turn.add_argument("--role", choices=["agent", "peer", "owner", "system"], required=True)
    call_turn.add_argument("--text", required=True)
    call_end = call_subs.add_parser("end")
    call_end.add_argument("--call", required=True)
    call_end.add_argument("--outcome", required=True)
    call_end.add_argument("--success", action="store_true")
    call_end.add_argument("--summary")
    call_show = call_subs.add_parser("show")
    call_show.add_argument("call")
    call_list = call_subs.add_parser("list")
    call_list.add_argument("--limit", type=int, default=20)
    call.set_defaults(func=cmd_call, limit=20)

    # -- appointment --------------------------------------------------------
    appointment = subs.add_parser("appointment", help="proposed and confirmed commitments")
    appointment_subs = appointment.add_subparsers(dest="appointment_cmd", required=True)
    propose = appointment_subs.add_parser("propose")
    propose.add_argument("--title", required=True)
    propose.add_argument("--with", dest="with_")
    propose.add_argument("--start")
    propose.add_argument("--end")
    propose.add_argument("--location")
    propose.add_argument("--call")
    propose.add_argument("--notes")
    confirm = appointment_subs.add_parser("confirm")
    confirm.add_argument("id")
    confirm.add_argument("--start")
    confirm.add_argument("--end")
    confirm.add_argument("--external-id", dest="external_id")
    cancel = appointment_subs.add_parser("cancel")
    cancel.add_argument("id")
    cancel.add_argument("--reason")
    appointment_list = appointment_subs.add_parser("list")
    appointment_list.add_argument("--status", choices=["proposed", "confirmed", "cancelled"])
    appointment.set_defaults(func=cmd_appointment, status=None)

    # -- approval -----------------------------------------------------------
    approval = subs.add_parser("approval", help="human-in-the-loop decisions")
    approval_subs = approval.add_subparsers(dest="approval_cmd", required=True)
    request = approval_subs.add_parser("request")
    request.add_argument("--subject", required=True)
    request.add_argument("--detail")
    request.add_argument("--option", action="append")
    request.add_argument("--ref", help="id of the thing being approved (appointment, quote...)")
    request.add_argument("--channel", default="any")
    request.add_argument("--expires")
    for verb in ("approve", "deny"):
        node = approval_subs.add_parser(verb)
        node.add_argument("id")
        node.add_argument("--via", default="cli")
        node.add_argument("--note")
    check = approval_subs.add_parser("check")
    check.add_argument("id")
    approval_list = approval_subs.add_parser("list")
    approval_list.add_argument("--pending", action="store_true")
    approval.set_defaults(func=cmd_approval, pending=False)

    # -- lead ---------------------------------------------------------------
    lead = subs.add_parser("lead", help="pipeline")
    lead_subs = lead.add_subparsers(dest="lead_cmd", required=True)
    lead_add = lead_subs.add_parser("add")
    lead_add.add_argument("--name")
    lead_add.add_argument("--contact")
    lead_add.add_argument("--phone")
    lead_add.add_argument("--source")
    lead_add.add_argument("--need")
    lead_add.add_argument("--value", default="0")
    lead_add.add_argument("--currency", default="USD")
    lead_status = lead_subs.add_parser("status")
    lead_status.add_argument("id")
    lead_status.add_argument("status", choices=["new", "contacted", "quoted", "won", "lost"])
    lead_subs.add_parser("list")
    lead.set_defaults(func=cmd_lead)

    # -- quote / invoice ----------------------------------------------------
    def add_document_flags(node: argparse.ArgumentParser) -> None:
        node.add_argument("--to", help="contact name, phone or id")
        node.add_argument("--lead")
        node.add_argument("--title")
        node.add_argument("--number")
        node.add_argument("--item", action="append", required=True, help="'Description x2 @ 150.00' (repeatable)")
        node.add_argument("--tax", type=float, default=0)
        node.add_argument("--currency", default="USD")
        node.add_argument("--notes")
        node.add_argument("--render", choices=["pdf", "html", "md"], help="also write a document to artifacts/")

    quote = subs.add_parser("quote", help="quotations")
    quote_subs = quote.add_subparsers(dest="quote_cmd", required=True)
    quote_create = quote_subs.add_parser("create")
    add_document_flags(quote_create)
    quote_create.add_argument("--valid-until", dest="valid_until")
    quote_status = quote_subs.add_parser("status")
    quote_status.add_argument("id")
    quote_status.add_argument("status", choices=["draft", "sent", "accepted", "rejected"])
    quote_subs.add_parser("list")
    quote.set_defaults(func=cmd_quote)

    invoice = subs.add_parser("invoice", help="invoices")
    invoice_subs = invoice.add_subparsers(dest="invoice_cmd", required=True)
    invoice_create = invoice_subs.add_parser("create")
    add_document_flags(invoice_create)
    invoice_create.add_argument("--due")
    invoice_pay = invoice_subs.add_parser("pay")
    invoice_pay.add_argument("id")
    invoice_pay.add_argument("--via")
    invoice_list = invoice_subs.add_parser("list")
    invoice_list.add_argument("--unpaid", action="store_true")
    invoice.set_defaults(func=cmd_invoice, unpaid=False)

    # -- pref ---------------------------------------------------------------
    pref = subs.add_parser("pref", help="owner preferences the agent must respect")
    pref_subs = pref.add_subparsers(dest="pref_cmd", required=True)
    pref_set = pref_subs.add_parser("set")
    pref_set.add_argument("key")
    pref_set.add_argument("value")
    pref_get = pref_subs.add_parser("get")
    pref_get.add_argument("key")
    pref_subs.add_parser("list")
    pref.set_defaults(func=cmd_pref)

    # -- readouts -----------------------------------------------------------
    brief = subs.add_parser("brief", help="what matters right now")
    brief.set_defaults(func=cmd_brief)

    context = subs.add_parser("context", help="system-prompt block for an LLM")
    context.set_defaults(func=cmd_context)

    recall = subs.add_parser("recall", help="search everything")
    recall.add_argument("query")
    recall.add_argument("--limit", type=int, default=20)
    recall.set_defaults(func=cmd_recall)

    calendar = subs.add_parser("calendar", help="write confirmed appointments as an .ics any calendar can read")
    calendar.add_argument("--output", "-o")
    calendar.add_argument("--include-proposed", action="store_true", help="include unconfirmed holds as tentative")
    calendar.set_defaults(func=cmd_calendar)

    log = subs.add_parser("log", help="raw event log")
    log.add_argument("--limit", type=int, default=30)
    log.add_argument("--type")
    log.set_defaults(func=cmd_log)

    verify = subs.add_parser("verify", help="prove the log has not been edited")
    verify.set_defaults(func=cmd_verify)

    export = subs.add_parser("export", help="dump the whole brain")
    export.add_argument("--output", "-o")
    export.add_argument("--include-log", action="store_true")
    export.set_defaults(func=cmd_export)

    doctor = subs.add_parser("doctor", help="health check")
    doctor.set_defaults(func=cmd_doctor)

    serve = subs.add_parser("serve", help="HTTP API for webhooks")
    serve.add_argument("--host", default="127.0.0.1")
    serve.add_argument("--port", type=int, default=7431)
    serve.add_argument("--token")
    serve.add_argument("--verbose", action="store_true")
    serve.set_defaults(func=cmd_serve)

    mcp = subs.add_parser("mcp", help="MCP server over stdio")
    mcp.set_defaults(func=cmd_mcp)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    brain = Brain(brain_home(args.home))
    out = Out(args.json)
    try:
        return args.func(brain, args, out)
    except BrainError as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        else:
            print(f"error: {exc}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
