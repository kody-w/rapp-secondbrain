#!/usr/bin/env python3
"""
rsb — RAPP Second Brain

A local-first, zero-dependency second brain for AI agents.

Everything an assistant needs to act on your behalf in the real world — who you
know, what it promised, what it heard on a phone call, what you approved, what
you're owed — stored as a tamper-evident append-only event log on your own disk.

No server. No API keys. No dependencies beyond the Python standard library.

    rsb init
    rsb contact add --name "Bella Vista" --phone "+15551234567"
    rsb call start --to "+15551234567" --objective "book a table for 2 at 7pm Friday"
    rsb brief

Docs: https://github.com/kody-w/rapp-secondbrain
"""

from __future__ import annotations

__version__ = "1.0.0"
SPEC = "rapp-second-brain/1.0"

import argparse
import datetime as _dt
import hashlib
import json
import os
import re
import sys
import uuid
from pathlib import Path
from typing import Any, Callable, Iterable, Iterator

# --------------------------------------------------------------------------
# paths
# --------------------------------------------------------------------------

DEFAULT_HOME = "~/.rapp-second-brain"


def brain_home(override: str | None = None) -> Path:
    raw = override or os.environ.get("RAPP_SECOND_BRAIN_HOME") or DEFAULT_HOME
    return Path(os.path.expanduser(raw)).resolve()


# --------------------------------------------------------------------------
# primitives
# --------------------------------------------------------------------------


def now_iso() -> str:
    """UTC timestamp, second resolution, always suffixed Z."""
    return _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def canon(obj: Any) -> str:
    """Canonical JSON — stable key order, no incidental whitespace."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def sha(text: str) -> str:
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def new_id(prefix: str) -> str:
    return f"{prefix}_{uuid.uuid4().hex[:12]}"


def slug(text: str, maxlen: int = 40) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
    return s[:maxlen] or "item"


class BrainError(Exception):
    """User-facing error — printed without a traceback."""


# --------------------------------------------------------------------------
# money — integer cents everywhere, never floats
# --------------------------------------------------------------------------


def to_cents(value: Any) -> int:
    """Parse '1,234.56' / '1234.56' / 1234.56 / 123456c into integer cents."""
    if value is None or value == "":
        return 0
    if isinstance(value, int):
        return value * 100
    if isinstance(value, float):
        return int(round(value * 100))
    text = str(value).strip().replace(",", "").replace("$", "")
    if text.endswith("c"):
        return int(text[:-1])
    try:
        return int(round(float(text) * 100))
    except ValueError as exc:
        raise BrainError(f"not a valid amount: {value!r}") from exc


def money(cents: int, currency: str = "USD") -> str:
    sign = "-" if cents < 0 else ""
    cents = abs(int(cents))
    symbol = {"USD": "$", "EUR": "\u20ac", "GBP": "\u00a3"}.get(currency.upper(), "")
    body = f"{cents // 100:,}.{cents % 100:02d}"
    return f"{sign}{symbol}{body}" if symbol else f"{sign}{body} {currency.upper()}"


# --------------------------------------------------------------------------
# time parsing — deterministic, no dependencies
# --------------------------------------------------------------------------

_WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]


def parse_when(text: str | None, *, ref: _dt.datetime | None = None) -> str | None:
    """Parse a human-ish time into an ISO-8601 local timestamp.

    Accepts full ISO, 'tomorrow 7pm', 'friday 19:30', '+2h', 'today', '7pm'.
    Returns None for empty input. Raises BrainError on genuinely unparseable
    input so a caller never silently books the wrong time.
    """
    if not text:
        return None
    raw = str(text).strip()
    ref = ref or _dt.datetime.now()

    # already ISO?
    try:
        parsed = _dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        return parsed.replace(microsecond=0).isoformat()
    except ValueError:
        pass

    low = raw.lower()

    # relative offsets: +90m, +2h, +3d
    rel = re.fullmatch(r"\+(\d+)\s*(m|min|mins|h|hr|hrs|d|day|days)", low)
    if rel:
        amount, unit = int(rel.group(1)), rel.group(2)
        delta = {
            "m": _dt.timedelta(minutes=amount),
            "min": _dt.timedelta(minutes=amount),
            "mins": _dt.timedelta(minutes=amount),
            "h": _dt.timedelta(hours=amount),
            "hr": _dt.timedelta(hours=amount),
            "hrs": _dt.timedelta(hours=amount),
            "d": _dt.timedelta(days=amount),
            "day": _dt.timedelta(days=amount),
            "days": _dt.timedelta(days=amount),
        }[unit]
        return (ref + delta).replace(second=0, microsecond=0).isoformat()

    # split a day-word off the front, keep the rest as a clock time
    day = ref.date()
    rest = low
    matched_day = False

    for word, offset in (("today", 0), ("tonight", 0), ("tomorrow", 1), ("overmorrow", 2)):
        if low.startswith(word):
            day = ref.date() + _dt.timedelta(days=offset)
            rest = low[len(word) :].strip()
            matched_day = True
            break

    if not matched_day:
        for idx, name in enumerate(_WEEKDAYS):
            if low.startswith(name) or low.startswith(name[:3] + " "):
                token = name if low.startswith(name) else name[:3]
                ahead = (idx - ref.weekday()) % 7 or 7  # always the *next* one
                day = ref.date() + _dt.timedelta(days=ahead)
                rest = low[len(token) :].strip()
                matched_day = True
                break

    rest = re.sub(r"^(at|@|on)\s+", "", rest).strip()

    hour, minute = None, 0
    clock = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm)?", rest) if rest else None
    if clock:
        hour = int(clock.group(1))
        minute = int(clock.group(2) or 0)
        meridiem = clock.group(3)
        if meridiem == "pm" and hour < 12:
            hour += 12
        elif meridiem == "am" and hour == 12:
            hour = 0
        elif meridiem is None and low.startswith("tonight") and hour < 12:
            hour += 12
    elif rest:
        raise BrainError(f"could not understand the time {text!r} (try ISO, '7pm', 'tomorrow 19:30', '+2h')")

    if hour is None:
        if not matched_day:
            raise BrainError(f"could not understand the time {text!r}")
        hour, minute = 9, 0  # a bare day means "morning"

    if not (0 <= hour <= 23 and 0 <= minute <= 59):
        raise BrainError(f"time out of range in {text!r}")

    return _dt.datetime.combine(day, _dt.time(hour, minute)).isoformat()


def human_when(iso: str | None) -> str:
    if not iso:
        return "unscheduled"
    try:
        parsed = _dt.datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return iso
    return parsed.strftime("%a %d %b %Y at %-I:%M %p") if os.name != "nt" else parsed.strftime("%a %d %b %Y at %I:%M %p")


# --------------------------------------------------------------------------
# phone normalisation — so "(555) 123-4567" and "+15551234567" are one contact
# --------------------------------------------------------------------------


def normalize_phone(raw: str | None, default_country: str = "1") -> str | None:
    if not raw:
        return None
    text = str(raw).strip()
    if text.lower().startswith("sim:"):  # simulation handles are opaque
        return text
    digits = re.sub(r"[^\d+]", "", text)
    if digits.startswith("+"):
        return "+" + re.sub(r"\D", "", digits[1:])
    digits = re.sub(r"\D", "", digits)
    if not digits:
        return None
    if len(digits) == 10 and default_country == "1":
        return "+1" + digits
    if len(digits) == 11 and digits.startswith("1") and default_country == "1":
        return "+" + digits
    return "+" + digits


# --------------------------------------------------------------------------
# the log
# --------------------------------------------------------------------------

GENESIS = "sha256:" + "0" * 64


class Brain:
    """Append-only, hash-chained event log plus derived projections.

    The log is the truth. Projections are a pure fold over it and can always be
    thrown away and rebuilt — which is what makes the brain auditable: you can
    prove exactly which event caused the assistant to believe anything.
    """

    def __init__(self, root: Path):
        self.root = root
        self.log_path = root / "events.jsonl"
        self.cache_path = root / ".cache" / "state.json"
        self._state: dict | None = None

    # -- lifecycle ---------------------------------------------------------

    def exists(self) -> bool:
        return self.log_path.exists()

    def init(self, *, owner: str | None = None) -> dict:
        self.root.mkdir(parents=True, exist_ok=True)
        (self.root / ".cache").mkdir(exist_ok=True)
        (self.root / "artifacts").mkdir(exist_ok=True)
        if not self.log_path.exists():
            self.log_path.touch()
        gitignore = self.root / ".gitignore"
        if not gitignore.exists():
            gitignore.write_text(".cache/\nartifacts/\nsecrets*\n*.pem\n", encoding="utf-8")
        return self.append("brain.init", {"owner": owner or os.environ.get("USER", "owner"), "spec": SPEC, "version": __version__})

    def require(self) -> None:
        if not self.exists():
            raise BrainError(f"no brain at {self.root} — run `rsb init` first")

    # -- writing -----------------------------------------------------------

    def _last_hash(self) -> tuple[str, int]:
        prev, seq = GENESIS, 0
        for event in self.read():
            prev, seq = event["hash"], event["seq"]
        return prev, seq

    def append(self, event_type: str, payload: dict, *, actor: str = "cli") -> dict:
        self.root.mkdir(parents=True, exist_ok=True)
        prev, seq = self._last_hash()
        body = {
            "seq": seq + 1,
            "id": new_id("ev"),
            "ts": now_iso(),
            "type": event_type,
            "actor": actor,
            "payload": payload,
            "prev": prev,
        }
        body["hash"] = sha(canon(body))
        with self.log_path.open("a", encoding="utf-8") as handle:
            handle.write(canon(body) + "\n")
        self._state = None
        if self.cache_path.exists():
            self.cache_path.unlink()
        return body

    # -- reading -----------------------------------------------------------

    def read(self) -> Iterator[dict]:
        if not self.log_path.exists():
            return
        with self.log_path.open("r", encoding="utf-8") as handle:
            for lineno, line in enumerate(handle, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except json.JSONDecodeError as exc:
                    raise BrainError(f"corrupt event log at line {lineno}: {exc}") from exc

    def verify(self) -> tuple[bool, list[str]]:
        problems: list[str] = []
        prev, expected_seq = GENESIS, 1
        for event in self.read():
            if event.get("prev") != prev:
                problems.append(f"seq {event.get('seq')}: broken chain (prev mismatch)")
            if event.get("seq") != expected_seq:
                problems.append(f"expected seq {expected_seq}, found {event.get('seq')}")
            body = {k: v for k, v in event.items() if k != "hash"}
            if sha(canon(body)) != event.get("hash"):
                problems.append(f"seq {event.get('seq')}: hash mismatch (event was edited)")
            prev = event.get("hash", prev)
            expected_seq = (event.get("seq") or expected_seq) + 1
        return (not problems), problems

    def state(self) -> dict:
        if self._state is None:
            self._state = fold(self.read())
        return self._state


# --------------------------------------------------------------------------
# projections — a pure fold over the log
# --------------------------------------------------------------------------


def empty_state() -> dict:
    return {
        "owner": None,
        "contacts": {},
        "calls": {},
        "appointments": {},
        "approvals": {},
        "leads": {},
        "quotes": {},
        "invoices": {},
        "notes": [],
        "prefs": {},
        "counts": {},
    }


def fold(events: Iterable[dict]) -> dict:
    state = empty_state()
    total = 0

    for event in events:
        total += 1
        kind = event.get("type", "")
        data = event.get("payload") or {}
        state["counts"][kind] = state["counts"].get(kind, 0) + 1

        if kind == "brain.init":
            state["owner"] = data.get("owner")

        elif kind == "contact.upsert":
            existing = state["contacts"].get(data["id"], {})
            merged = {**existing, **{k: v for k, v in data.items() if v is not None}}
            merged.setdefault("created_at", event["ts"])
            merged["updated_at"] = event["ts"]
            state["contacts"][data["id"]] = merged

        elif kind == "note.add":
            state["notes"].append({**data, "ts": event["ts"], "seq": event["seq"]})

        elif kind == "pref.set":
            state["prefs"][data["key"]] = data["value"]

        elif kind == "call.start":
            state["calls"][data["id"]] = {
                **data,
                "status": "in_progress",
                "turns": [],
                "started_at": event["ts"],
            }

        elif kind == "call.turn":
            call = state["calls"].get(data["call_id"])
            if call is not None:
                call["turns"].append({"role": data["role"], "text": data["text"], "ts": event["ts"]})

        elif kind == "call.end":
            call = state["calls"].get(data["call_id"])
            if call is not None:
                call.update(
                    status="ended",
                    outcome=data.get("outcome", "unknown"),
                    success=bool(data.get("success")),
                    summary=data.get("summary", ""),
                    ended_at=event["ts"],
                )

        elif kind == "appointment.propose":
            state["appointments"][data["id"]] = {**data, "status": "proposed", "created_at": event["ts"]}

        elif kind in ("appointment.confirm", "appointment.cancel"):
            appointment = state["appointments"].get(data["id"])
            if appointment is not None:
                appointment["status"] = "confirmed" if kind.endswith("confirm") else "cancelled"
                appointment["updated_at"] = event["ts"]
                for key in ("start", "end", "location", "external_id", "reason"):
                    if data.get(key) is not None:
                        appointment[key] = data[key]

        elif kind == "approval.request":
            state["approvals"][data["id"]] = {**data, "status": "pending", "created_at": event["ts"]}

        elif kind == "approval.decide":
            approval = state["approvals"].get(data["id"])
            if approval is not None:
                approval["status"] = data["decision"]
                approval["decided_at"] = event["ts"]
                approval["decided_via"] = data.get("via", "cli")
                approval["decision_note"] = data.get("note", "")

        elif kind == "lead.add":
            state["leads"][data["id"]] = {**data, "status": data.get("status", "new"), "created_at": event["ts"]}

        elif kind == "lead.status":
            lead = state["leads"].get(data["id"])
            if lead is not None:
                lead["status"] = data["status"]
                lead["updated_at"] = event["ts"]

        elif kind == "quote.create":
            state["quotes"][data["id"]] = {**data, "status": "draft", "created_at": event["ts"]}

        elif kind == "quote.status":
            quote = state["quotes"].get(data["id"])
            if quote is not None:
                quote["status"] = data["status"]
                quote["updated_at"] = event["ts"]

        elif kind == "invoice.create":
            state["invoices"][data["id"]] = {**data, "status": "unpaid", "created_at": event["ts"]}

        elif kind == "invoice.pay":
            invoice = state["invoices"].get(data["id"])
            if invoice is not None:
                invoice["status"] = "paid"
                invoice["paid_at"] = event["ts"]
                invoice["paid_via"] = data.get("via", "")

        elif kind == "doc.render":
            for bucket in ("quotes", "invoices"):
                record = state[bucket].get(data.get("ref", ""))
                if record is not None:
                    record.setdefault("docs", []).append({"path": data["path"], "format": data["format"], "ts": event["ts"]})

    state["counts"]["_total"] = total
    return state


# --------------------------------------------------------------------------
# lookup helpers
# --------------------------------------------------------------------------


def find_contact(state: dict, needle: str | None) -> dict | None:
    """Resolve a contact by id, exact phone, or case-insensitive name substring."""
    if not needle:
        return None
    contacts = state["contacts"]
    if needle in contacts:
        return contacts[needle]

    phone = normalize_phone(needle)
    if phone:
        for contact in contacts.values():
            if contact.get("phone") == phone:
                return contact

    low = needle.lower()
    exact = [c for c in contacts.values() if (c.get("name") or "").lower() == low]
    if exact:
        return exact[0]
    partial = [c for c in contacts.values() if low in (c.get("name") or "").lower()]
    return partial[0] if len(partial) >= 1 else None


def resolve(state: dict, bucket: str, key: str) -> dict:
    """Resolve an id, tolerating unambiguous short prefixes."""
    records = state[bucket]
    if key in records:
        return records[key]
    hits = [record for rid, record in records.items() if rid.endswith(key) or rid.startswith(key)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise BrainError(f"no {bucket[:-1]} matching {key!r}")
    raise BrainError(f"{key!r} is ambiguous — matches {len(hits)} {bucket}")


def line_items(raw: list[str] | None) -> tuple[list[dict], int]:
    """Parse repeated --item 'Description x2 @ 150.00' flags into structured rows."""
    items: list[dict] = []
    total = 0
    for entry in raw or []:
        text = entry.strip()
        match = re.match(r"^(.*?)(?:\s+x\s*(\d+(?:\.\d+)?))?\s*@\s*([\d.,$]+)$", text, re.IGNORECASE)
        if not match:
            raise BrainError(f"bad --item {entry!r} — use 'Description x2 @ 150.00'")
        description = match.group(1).strip()
        qty = float(match.group(2) or 1)
        unit_cents = to_cents(match.group(3))
        amount = int(round(unit_cents * qty))
        items.append({"description": description, "qty": qty, "unit_cents": unit_cents, "amount_cents": amount})
        total += amount
    return items, total


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------


class Out:
    def __init__(self, as_json: bool):
        self.as_json = as_json

    def emit(self, payload: dict, text: str = "") -> None:
        if self.as_json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        elif text:
            print(text)

    def table(self, rows: list[list[str]], headers: list[str]) -> str:
        if not rows:
            return "  (none)"
        widths = [len(h) for h in headers]
        for row in rows:
            for i, cell in enumerate(row):
                widths[i] = max(widths[i], len(str(cell)))
        out = ["  " + "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip()]
        out.append("  " + "  ".join("-" * widths[i] for i in range(len(headers))))
        for row in rows:
            out.append("  " + "  ".join(str(c).ljust(widths[i]) for i, c in enumerate(row)).rstrip())
        return "\n".join(out)


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


def cmd_init(brain: Brain, args, out: Out) -> int:
    fresh = not brain.exists()
    event = brain.init(owner=args.owner)
    out.emit(
        {"ok": True, "root": str(brain.root), "created": fresh, "spec": SPEC, "version": __version__},
        f"{'Created' if fresh else 'Re-initialised'} RAPP Second Brain at {brain.root}\n"
        f"  spec {SPEC}   event {event['seq']}\n\n"
        f"Next: rsb contact add --name 'Someone' --phone '+1555...'",
    )
    return 0


def cmd_note(brain: Brain, args, out: Out) -> int:
    brain.require()
    if args.note_cmd == "add":
        payload = {"text": args.text, "tags": args.tag or [], "source": args.source or "cli"}
        event = brain.append("note.add", payload, actor=args.actor)
        out.emit({"ok": True, "seq": event["seq"], "note": payload}, f"Remembered (event {event['seq']}).")
        return 0

    notes = brain.state()["notes"]
    query = (args.query or "").lower()
    tags = set(args.tag or [])
    hits = [
        n
        for n in notes
        if (not query or query in n["text"].lower())
        and (not tags or tags & set(n.get("tags") or []))
    ]
    hits = hits[-args.limit :]
    out.emit(
        {"ok": True, "count": len(hits), "notes": hits},
        "\n".join(f"  [{n['ts']}] {n['text']}" + (f"  #{' #'.join(n['tags'])}" if n.get("tags") else "") for n in hits)
        or "  (nothing remembered yet)",
    )
    return 0


def cmd_contact(brain: Brain, args, out: Out) -> int:
    brain.require()
    state = brain.state()

    if args.contact_cmd == "add":
        existing = find_contact(state, normalize_phone(args.phone) or args.name)
        contact_id = existing["id"] if existing else new_id("ct")
        payload = {
            "id": contact_id,
            "name": args.name,
            "phone": normalize_phone(args.phone),
            "email": args.email,
            "org": args.org,
            "role": args.role,
            "notes": args.notes,
            "tags": args.tag or None,
        }
        payload = {k: v for k, v in payload.items() if v is not None}
        brain.append("contact.upsert", payload, actor=args.actor)
        out.emit(
            {"ok": True, "contact": payload, "updated": bool(existing)},
            f"{'Updated' if existing else 'Added'} contact {payload.get('name', contact_id)} ({contact_id}).",
        )
        return 0

    if args.contact_cmd == "find":
        contact = find_contact(state, args.query)
        if not contact:
            out.emit({"ok": False, "error": "not found", "query": args.query}, f"No contact matching {args.query!r}.")
            return 1
        out.emit({"ok": True, "contact": contact}, _render_contact(contact))
        return 0

    contacts = sorted(state["contacts"].values(), key=lambda c: (c.get("name") or "").lower())
    rows = [[c.get("name", ""), c.get("phone", ""), c.get("org", ""), c["id"]] for c in contacts]
    out.emit({"ok": True, "count": len(contacts), "contacts": contacts}, out.table(rows, ["NAME", "PHONE", "ORG", "ID"]))
    return 0


def _render_contact(contact: dict) -> str:
    lines = [f"{contact.get('name', '(unnamed)')}  [{contact['id']}]"]
    for label, key in (("phone", "phone"), ("email", "email"), ("org", "org"), ("role", "role"), ("notes", "notes")):
        if contact.get(key):
            lines.append(f"  {label:6} {contact[key]}")
    if contact.get("tags"):
        lines.append(f"  tags   {' '.join(contact['tags'])}")
    return "\n".join(lines)


def cmd_call(brain: Brain, args, out: Out) -> int:
    brain.require()
    state = brain.state()

    if args.call_cmd == "start":
        contact = find_contact(state, args.to)
        phone = normalize_phone(args.to) or (contact or {}).get("phone")
        if not phone:
            raise BrainError(f"cannot resolve a phone number from {args.to!r}")
        payload = {
            "id": new_id("call"),
            "direction": args.direction,
            "peer": phone,
            "contact_id": (contact or {}).get("id"),
            "contact_name": (contact or {}).get("name"),
            "objective": args.objective,
            "constraints": args.constraint or [],
            "provider": args.provider,
        }
        brain.append("call.start", payload, actor=args.actor)
        out.emit(
            {"ok": True, "call": payload},
            f"Call {payload['id']} started — {args.direction} {phone}\n  objective: {args.objective or '(none)'}",
        )
        return 0

    if args.call_cmd == "turn":
        call = resolve(state, "calls", args.call)
        payload = {"call_id": call["id"], "role": args.role, "text": args.text}
        event = brain.append("call.turn", payload, actor=args.actor)
        out.emit({"ok": True, "seq": event["seq"], "turn": payload}, f"  {args.role}: {args.text}")
        return 0

    if args.call_cmd == "end":
        call = resolve(state, "calls", args.call)
        payload = {
            "call_id": call["id"],
            "outcome": args.outcome,
            "success": args.success,
            "summary": args.summary or "",
        }
        brain.append("call.end", payload, actor=args.actor)
        out.emit(
            {"ok": True, "call_id": call["id"], "outcome": args.outcome, "success": args.success},
            f"Call {call['id']} ended — {args.outcome} ({'success' if args.success else 'no deal'}).",
        )
        return 0

    if args.call_cmd == "show":
        call = resolve(state, "calls", args.call)
        transcript = "\n".join(f"  {t['role']:6} {t['text']}" for t in call.get("turns", []))
        out.emit(
            {"ok": True, "call": call},
            f"Call {call['id']}  {call['direction']} {call['peer']}  [{call.get('status')}]\n"
            f"  objective: {call.get('objective') or '(none)'}\n"
            f"  outcome:   {call.get('outcome', '-')}\n\n{transcript or '  (no transcript)'}",
        )
        return 0

    calls = sorted(state["calls"].values(), key=lambda c: c.get("started_at", ""), reverse=True)[: args.limit]
    rows = [
        [c.get("started_at", "")[:16], c["direction"], c.get("contact_name") or c["peer"], c.get("status", ""), c.get("outcome", "-"), c["id"]]
        for c in calls
    ]
    out.emit({"ok": True, "count": len(calls), "calls": calls}, out.table(rows, ["WHEN", "DIR", "PEER", "STATUS", "OUTCOME", "ID"]))
    return 0


def cmd_appointment(brain: Brain, args, out: Out) -> int:
    brain.require()
    state = brain.state()

    if args.appointment_cmd == "propose":
        contact = find_contact(state, args.with_)
        payload = {
            "id": new_id("appt"),
            "title": args.title,
            "with": (contact or {}).get("name") or args.with_,
            "contact_id": (contact or {}).get("id"),
            "start": parse_when(args.start),
            "end": parse_when(args.end),
            "location": args.location,
            "call_id": args.call,
            "notes": args.notes,
        }
        brain.append("appointment.propose", payload, actor=args.actor)
        out.emit(
            {"ok": True, "appointment": payload},
            f"Proposed {payload['id']}: {payload['title']} with {payload['with']} — {human_when(payload['start'])}",
        )
        return 0

    if args.appointment_cmd in ("confirm", "cancel"):
        appointment = resolve(state, "appointments", args.id)
        payload = {"id": appointment["id"]}
        if args.appointment_cmd == "confirm":
            if args.start:
                payload["start"] = parse_when(args.start)
            if args.end:
                payload["end"] = parse_when(args.end)
            if getattr(args, "external_id", None):
                payload["external_id"] = args.external_id
        elif getattr(args, "reason", None):
            payload["reason"] = args.reason
        brain.append(f"appointment.{args.appointment_cmd}", payload, actor=args.actor)
        merged = {**appointment, **payload}
        out.emit(
            {"ok": True, "appointment_id": appointment["id"], "status": "confirmed" if args.appointment_cmd == "confirm" else "cancelled"},
            f"{args.appointment_cmd.title()}ed {appointment['id']} — {merged.get('title')} {human_when(merged.get('start'))}",
        )
        return 0

    appointments = sorted(state["appointments"].values(), key=lambda a: a.get("start") or "")
    if args.status:
        appointments = [a for a in appointments if a["status"] == args.status]
    rows = [[human_when(a.get("start")), a.get("title", ""), a.get("with", ""), a["status"], a["id"]] for a in appointments]
    out.emit({"ok": True, "count": len(appointments), "appointments": appointments}, out.table(rows, ["WHEN", "TITLE", "WITH", "STATUS", "ID"]))
    return 0


def cmd_approval(brain: Brain, args, out: Out) -> int:
    brain.require()
    state = brain.state()

    if args.approval_cmd == "request":
        payload = {
            "id": new_id("apr"),
            "subject": args.subject,
            "detail": args.detail or "",
            "options": args.option or ["approve", "deny"],
            "ref": args.ref,
            "channel": args.channel,
            "expires_at": parse_when(args.expires),
        }
        brain.append("approval.request", payload, actor=args.actor)
        out.emit(
            {"ok": True, "approval": payload},
            f"Approval {payload['id']} requested: {payload['subject']}\n  {payload['detail']}",
        )
        return 0

    if args.approval_cmd in ("approve", "deny"):
        approval = resolve(state, "approvals", args.id)
        if approval["status"] != "pending":
            raise BrainError(f"approval {approval['id']} is already {approval['status']}")
        payload = {"id": approval["id"], "decision": args.approval_cmd, "via": args.via, "note": args.note or ""}
        brain.append("approval.decide", payload, actor=args.actor)
        out.emit(
            {"ok": True, "approval_id": approval["id"], "decision": args.approval_cmd, "ref": approval.get("ref")},
            f"{args.approval_cmd.title()}d {approval['id']} — {approval['subject']}",
        )
        return 0

    if args.approval_cmd == "check":
        approval = resolve(state, "approvals", args.id)
        out.emit(
            {"ok": True, "approval": approval, "pending": approval["status"] == "pending", "granted": approval["status"] == "approve"},
            f"{approval['id']}  {approval['status']}  {approval['subject']}",
        )
        return 0 if approval["status"] == "approve" else 1

    approvals = sorted(state["approvals"].values(), key=lambda a: a.get("created_at", ""), reverse=True)
    if args.pending:
        approvals = [a for a in approvals if a["status"] == "pending"]
    rows = [[a.get("created_at", "")[:16], a["status"], a["subject"][:48], a["id"]] for a in approvals]
    out.emit({"ok": True, "count": len(approvals), "approvals": approvals}, out.table(rows, ["WHEN", "STATUS", "SUBJECT", "ID"]))
    return 0


def cmd_lead(brain: Brain, args, out: Out) -> int:
