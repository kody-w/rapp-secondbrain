def render_document(brain: Brain, record: dict, kind: str, fmt: str) -> Path:
    artifacts = brain.root / "artifacts"
    artifacts.mkdir(parents=True, exist_ok=True)
    name = f"{record['number']}-{slug(record['bill_to'])}"
    currency = record.get("currency", "USD")

    if fmt == "pdf":
        return render_pdf(record, kind, artifacts / f"{name}.pdf")

    if fmt in ("md", "markdown"):
        lines = [
            f"# {record['title']} {record['number']}",
            "",
            f"**Bill to:** {record['bill_to']}  ",
            f"**Date:** {_dt.date.today().isoformat()}  ",
        ]
        if record.get("due"):
            lines.append(f"**Due:** {human_when(record['due'])}  ")
        if record.get("valid_until"):
            lines.append(f"**Valid until:** {human_when(record['valid_until'])}  ")
        lines += ["", "| Description | Qty | Unit | Amount |", "| --- | ---: | ---: | ---: |"]
        for item in record["items"]:
            lines.append(
                f"| {item['description']} | {item['qty']:g} | {money(item['unit_cents'], currency)} | {money(item['amount_cents'], currency)} |"
            )
        lines += ["", f"**Subtotal:** {money(record['subtotal_cents'], currency)}  "]
        if record.get("tax_cents"):
            lines.append(f"**Tax ({record['tax_percent']}%):** {money(record['tax_cents'], currency)}  ")
        lines.append(f"**Total:** {money(record['total_cents'], currency)}")
        if record.get("notes"):
            lines += ["", "---", "", record["notes"]]
        path = artifacts / f"{name}.md"
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        return path

    rows = "".join(
        f"<tr><td>{_esc(i['description'])}</td><td class=n>{i['qty']:g}</td>"
        f"<td class=n>{money(i['unit_cents'], currency)}</td><td class=n>{money(i['amount_cents'], currency)}</td></tr>"
        for i in record["items"]
    )
    tax_row = (
        f"<tr><td colspan=3 class=n>Tax ({record['tax_percent']}%)</td><td class=n>{money(record['tax_cents'], currency)}</td></tr>"
        if record.get("tax_cents")
        else ""
    )
    meta = f"<div><b>Date</b> {_dt.date.today().isoformat()}</div>"
    if record.get("due"):
        meta += f"<div><b>Due</b> {human_when(record['due'])}</div>"
    if record.get("valid_until"):
        meta += f"<div><b>Valid until</b> {human_when(record['valid_until'])}</div>"

    html = f"""<!doctype html><meta charset=utf-8><title>{_esc(record['title'])} {record['number']}</title>
<style>
 body{{font:15px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,sans-serif;color:#111;max-width:760px;margin:48px auto;padding:0 24px}}
 h1{{font-size:26px;margin:0 0 4px}} .sub{{color:#666;margin-bottom:28px}}
 .head{{display:flex;justify-content:space-between;gap:24px;margin-bottom:28px}}
 .head div div{{margin-bottom:2px}} b{{color:#666;font-weight:600;display:inline-block;min-width:86px}}
 table{{width:100%;border-collapse:collapse;margin:8px 0 16px}}
 th,td{{padding:9px 10px;border-bottom:1px solid #e5e5e5;text-align:left}}
 th{{background:#fafafa;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#666}}
 .n{{text-align:right;font-variant-numeric:tabular-nums}}
 .total td{{border-top:2px solid #111;border-bottom:none;font-weight:700;font-size:17px;padding-top:12px}}
 .notes{{margin-top:32px;padding-top:16px;border-top:1px solid #eee;color:#444;white-space:pre-wrap}}
 footer{{margin-top:48px;color:#999;font-size:12px}}
 @media print{{body{{margin:0}}}}
</style>
<h1>{_esc(record['title'])} {record['number']}</h1>
<div class=sub>{'Quotation' if kind == 'quote' else 'Invoice'}</div>
<div class=head><div><div><b>Bill to</b> {_esc(record['bill_to'])}</div></div><div>{meta}</div></div>
<table><thead><tr><th>Description</th><th class=n>Qty</th><th class=n>Unit</th><th class=n>Amount</th></tr></thead>
<tbody>{rows}
<tr><td colspan=3 class=n>Subtotal</td><td class=n>{money(record['subtotal_cents'], currency)}</td></tr>{tax_row}
<tr class=total><td colspan=3 class=n>Total</td><td class=n>{money(record['total_cents'], currency)}</td></tr></tbody></table>
{f'<div class=notes>{_esc(record["notes"])}</div>' if record.get('notes') else ''}
<footer>Generated by RAPP Second Brain \u00b7 {record['id']}</footer>
"""
    path = artifacts / f"{name}.html"
    path.write_text(html, encoding="utf-8")
    return path


def _esc(text: Any) -> str:
    return (
        str(text)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


