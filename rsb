def cmd_log(brain: Brain, args, out: Out) -> int:
    brain.require()
    events = list(brain.read())
    if args.type:
        events = [e for e in events if e["type"] == args.type]
    events = events[-args.limit :]
    out.emit(
        {"ok": True, "count": len(events), "events": events},
        "\n".join(f"  {e['seq']:>4}  {e['ts']}  {e['type']:24} {canon(e['payload'])[:90]}" for e in events),
    )
    return 0


def cmd_verify(brain: Brain, args, out: Out) -> int:
    brain.require()
    ok, problems = brain.verify()
    total = brain.state()["counts"].get("_total", 0)
    out.emit(
        {"ok": ok, "events": total, "problems": problems},
        f"Chain intact — {total} events verified." if ok else "TAMPERING DETECTED\n" + "\n".join(f"  {p}" for p in problems),
    )
    return 0 if ok else 2


def cmd_export(brain: Brain, args, out: Out) -> int:
    brain.require()
    bundle = {
        "spec": SPEC,
        "version": __version__,
        "exported_at": now_iso(),
        "state": brain.state(),
        "events": list(brain.read()) if args.include_log else None,
    }
    if args.output:
        path = Path(os.path.expanduser(args.output))
        path.write_text(json.dumps(bundle, indent=2, ensure_ascii=False), encoding="utf-8")
        out.emit({"ok": True, "path": str(path)}, f"Exported to {path}")
    else:
        print(json.dumps(bundle, indent=2, ensure_ascii=False))
    return 0


def cmd_doctor(brain: Brain, args, out: Out) -> int:
    checks = []
    checks.append({"check": "python", "ok": sys.version_info >= (3, 9), "detail": sys.version.split()[0]})
    checks.append({"check": "brain_exists", "ok": brain.exists(), "detail": str(brain.root)})
    if brain.exists():
        ok, problems = brain.verify()
        checks.append({"check": "chain_integrity", "ok": ok, "detail": "; ".join(problems) or "intact"})
        state = brain.state()
        checks.append({"check": "events", "ok": True, "detail": str(state["counts"].get("_total", 0))})
        writable = os.access(brain.root, os.W_OK)
        checks.append({"check": "writable", "ok": writable, "detail": "yes" if writable else "NO"})
    healthy = all(c["ok"] for c in checks)
    out.emit(
        {"ok": healthy, "checks": checks},
        "\n".join(f"  [{'ok' if c['ok'] else 'FAIL'}] {c['check']:18} {c['detail']}" for c in checks),
    )
    return 0 if healthy else 1


# --------------------------------------------------------------------------
# MCP server (stdio, JSON-RPC 2.0) — zero dependency
# --------------------------------------------------------------------------

MCP_TOOLS = [
    ("second_brain_brief", "Everything the assistant should know right now: upcoming appointments, pending approvals, open leads, unpaid invoices, recent calls.", {}),
    ("second_brain_recall", "Full-text search across contacts, notes, call transcripts, appointments, leads, quotes and invoices.", {"query": {"type": "string", "description": "What to search for"}}),
    ("second_brain_remember", "Store a durable fact about the owner or their world.", {"text": {"type": "string", "description": "The fact to remember"}}),
    ("second_brain_contact_find", "Look up a contact by name, phone number or id.", {"query": {"type": "string", "description": "Name, phone or id"}}),
    ("second_brain_pending_approvals", "List approvals the owner has not yet decided.", {}),
]


def cmd_mcp(brain: Brain, args, out: Out) -> int:
    def respond(request_id: Any, result: dict | None = None, error: dict | None = None) -> None:
        message: dict[str, Any] = {"jsonrpc": "2.0", "id": request_id}
        if error:
            message["error"] = error
        else:
            message["result"] = result
        sys.stdout.write(json.dumps(message) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            request = json.loads(line)
        except json.JSONDecodeError:
            continue
        method, request_id = request.get("method"), request.get("id")

        if method == "initialize":
            respond(request_id, {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "rapp-second-brain", "version": __version__},
            })
        elif method == "tools/list":
            respond(request_id, {
                "tools": [
                    {
                        "name": name,
                        "description": description,
                        "inputSchema": {"type": "object", "properties": props, "required": list(props.keys())},
                    }
                    for name, description, props in MCP_TOOLS
                ]
            })
        elif method == "tools/call":
            params = request.get("params") or {}
            name = params.get("name")
            arguments = params.get("arguments") or {}
            try:
                payload = _mcp_dispatch(brain, name, arguments)
                respond(request_id, {"content": [{"type": "text", "text": json.dumps(payload, indent=2, ensure_ascii=False)}]})
            except Exception as exc:  # surfaced to the model, never crashes the server
                respond(request_id, {"content": [{"type": "text", "text": f"error: {exc}"}], "isError": True})
        elif method and method.startswith("notifications/"):
            continue
        elif request_id is not None:
            respond(request_id, error={"code": -32601, "message": f"unknown method {method}"})
    return 0


def _mcp_dispatch(brain: Brain, name: str, arguments: dict) -> dict:
    brain.require()
    state = brain.state()
    if name == "second_brain_brief":
        return build_brief(state)
    if name == "second_brain_recall":
        query = (arguments.get("query") or "").lower()
        found = [n for n in state["notes"] if query in n["text"].lower()]
        contacts = [c for c in state["contacts"].values() if query in canon(c).lower()]
        calls = [
            {"id": c["id"], "peer": c.get("contact_name") or c["peer"], "objective": c.get("objective"), "outcome": c.get("outcome")}
            for c in state["calls"].values()
            if query in canon(c).lower()
        ]
        return {"query": arguments.get("query"), "notes": found, "contacts": contacts, "calls": calls}
    if name == "second_brain_remember":
        event = brain.append("note.add", {"text": arguments["text"], "tags": [], "source": "mcp"}, actor="mcp")
        return {"ok": True, "seq": event["seq"]}
    if name == "second_brain_contact_find":
        contact = find_contact(state, arguments.get("query"))
        return {"found": bool(contact), "contact": contact}
    if name == "second_brain_pending_approvals":
        return {"approvals": [a for a in state["approvals"].values() if a["status"] == "pending"]}
    raise BrainError(f"unknown tool {name}")


# --------------------------------------------------------------------------
# HTTP server — for webhooks (telephony providers, Telegram, cron)
# --------------------------------------------------------------------------


def cmd_serve(brain: Brain, args, out: Out) -> int:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    brain.require()
    token = args.token or os.environ.get("RAPP_SECOND_BRAIN_TOKEN")

    class Handler(BaseHTTPRequestHandler):
        server_version = f"rapp-second-brain/{__version__}"

        def _send(self, code: int, payload: dict) -> None:
            body = json.dumps(payload, indent=2, ensure_ascii=False).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _authorised(self) -> bool:
            if not token:
                return True
            supplied = (self.headers.get("Authorization") or "").removeprefix("Bearer ").strip()
            return supplied == token

        def log_message(self, fmt: str, *fmt_args: Any) -> None:
            if args.verbose:
                sys.stderr.write("  " + fmt % fmt_args + "\n")

        def do_GET(self) -> None:  # noqa: N802
            route = self.path.split("?")[0].rstrip("/") or "/"

            # A calendar subscription cannot send an Authorization header, so
            # the feed carries its own token in the path instead.
            if route.endswith("calendar.ics"):
                expected = f"/{token}/calendar.ics" if token else "/calendar.ics"
                if route != expected:
                    return self._send(401, {"error": "unauthorized"})
                body = render_ics(Brain(brain.root).state()).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/calendar; charset=utf-8")
                self.send_header("Content-Disposition", 'inline; filename="rapp-second-brain.ics"')
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                return self.wfile.write(body)

            if not self._authorised():
                return self._send(401, {"error": "unauthorized"})
            if route == "/":
                return self._send(200, {"service": "rapp-second-brain", "version": __version__, "spec": SPEC})
            if route == "/brief":
                return self._send(200, build_brief(Brain(brain.root).state()))
            if route == "/health":
                ok, problems = Brain(brain.root).verify()
                return self._send(200 if ok else 500, {"ok": ok, "problems": problems})
            if route.startswith("/state"):
                return self._send(200, Brain(brain.root).state())
            self._send(404, {"error": "not found"})

        def do_POST(self) -> None:  # noqa: N802
            if not self._authorised():
                return self._send(401, {"error": "unauthorized"})
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length).decode("utf-8") if length else "{}"
            try:
                body = json.loads(raw or "{}")
            except json.JSONDecodeError:
                return self._send(400, {"error": "invalid json"})
            route = self.path.split("?")[0].rstrip("/")
            if route == "/event":
                event_type, payload = body.get("type"), body.get("payload") or {}
                if not event_type:
                    return self._send(400, {"error": "type required"})
                event = Brain(brain.root).append(event_type, payload, actor=body.get("actor", "http"))
                return self._send(201, {"ok": True, "seq": event["seq"], "hash": event["hash"]})
            if route == "/remember":
                event = Brain(brain.root).append("note.add", {"text": body.get("text", ""), "tags": body.get("tags") or [], "source": "http"}, actor="http")
                return self._send(201, {"ok": True, "seq": event["seq"]})
            self._send(404, {"error": "not found"})

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    sys.stderr.write(f"RAPP Second Brain listening on http://{args.host}:{args.port}  (brain: {brain.root})\n")
    if not token:
        sys.stderr.write("  warning: no --token set; bind to localhost only\n")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\nstopped\n")
    return 0


