def text_width(text: str, size: float, bold: bool = False) -> float:
    table = _HELVETICA_BOLD if bold else _HELVETICA
    total = 0
    for char in text:
        code = ord(char)
        total += table[code - 32] if 32 <= code <= 126 else 556
    return total * size / 1000.0


class Pdf:
    """A single-page PDF built from text runs and rules."""

    def __init__(self, width: float = 612, height: float = 792):
        self.width = width
        self.height = height
        self._ops: list[str] = []

    @staticmethod
    def _escape(text: str) -> str:
        # Latin-1 is what the base-14 fonts speak; anything else degrades rather
        # than producing a corrupt file.
        safe = text.encode("latin-1", "replace").decode("latin-1")
        return safe.replace("\\", r"\\").replace("(", r"\(").replace(")", r"\)")

    def text(self, x: float, y: float, body: str, size: float = 11, bold: bool = False, gray: float = 0) -> None:
        font = "F2" if bold else "F1"
        self._ops.append(
            f"BT {gray:.2f} g /{font} {size:g} Tf 1 0 0 1 {x:.2f} {self.height - y:.2f} Tm ({self._escape(body)}) Tj ET"
        )

    def text_right(self, x: float, y: float, body: str, size: float = 11, bold: bool = False, gray: float = 0) -> None:
        self.text(x - text_width(body, size, bold), y, body, size, bold, gray)

    def rule(self, x1: float, y: float, x2: float, width: float = 0.5, gray: float = 0.8) -> None:
        top = self.height - y
        self._ops.append(f"{gray:.2f} G {width:g} w {x1:.2f} {top:.2f} m {x2:.2f} {top:.2f} l S")

    def build(self) -> bytes:
        content = "\n".join(self._ops).encode("latin-1", "replace")

        objects = [
            b"<< /Type /Catalog /Pages 2 0 R >>",
            b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
            (
                f"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 {self.width:g} {self.height:g}] "
                f"/Resources << /Font << /F1 5 0 R /F2 6 0 R >> >> /Contents 4 0 R >>"
            ).encode("latin-1"),
            b"<< /Length " + str(len(content)).encode() + b" >>\nstream\n" + content + b"\nendstream",
            b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>",
            b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>",
        ]

        out = bytearray(b"%PDF-1.4\n")
        offsets = [0]
        for index, body in enumerate(objects, start=1):
            offsets.append(len(out))
            out += f"{index} 0 obj\n".encode() + body + b"\nendobj\n"

        xref_at = len(out)
        out += f"xref\n0 {len(objects) + 1}\n".encode()
        out += b"0000000000 65535 f \n"
        for offset in offsets[1:]:
            out += f"{offset:010d} 00000 n \n".encode()
        out += (
            f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\nstartxref\n{xref_at}\n%%EOF\n".encode()
        )
        return bytes(out)


def render_pdf(record: dict, kind: str, path: Path) -> Path:
    currency = record.get("currency", "USD")
    pdf = Pdf()
    left, right = 56.0, 556.0
    y = 72.0

    pdf.text(left, y, f"{record['title']} {record['number']}", size=22, bold=True)
    y += 18
    pdf.text(left, y, "Quotation" if kind == "quote" else "Invoice", size=11, gray=0.45)

    y += 40
    pdf.text(left, y, "BILL TO", size=8, bold=True, gray=0.45)
    pdf.text(left, y + 15, str(record["bill_to"]), size=12)

    meta = [("Date", _dt.date.today().isoformat())]
    if record.get("due"):
        meta.append(("Due", human_when(record["due"])))
    if record.get("valid_until"):
        meta.append(("Valid until", human_when(record["valid_until"])))
    for offset, (label, value) in enumerate(meta):
        pdf.text_right(right, y + offset * 15, f"{label}: {value}", size=10, gray=0.35)

    y += 56
    pdf.rule(left, y, right, width=0.75, gray=0.75)
    y += 14
    pdf.text(left, y, "DESCRIPTION", size=8, bold=True, gray=0.45)
    pdf.text_right(right - 200, y, "QTY", size=8, bold=True, gray=0.45)
    pdf.text_right(right - 100, y, "UNIT", size=8, bold=True, gray=0.45)
    pdf.text_right(right, y, "AMOUNT", size=8, bold=True, gray=0.45)
    y += 8
    pdf.rule(left, y, right, width=0.75, gray=0.75)

    for item in record["items"]:
        y += 22
        description = item["description"]
        while text_width(description, 11) > 280 and len(description) > 4:
            description = description[:-2]
        if description != item["description"]:
            description = description[:-1] + "\u2026"
        pdf.text(left, y, description, size=11)
        pdf.text_right(right - 200, y, f"{item['qty']:g}", size=11)
        pdf.text_right(right - 100, y, money(item["unit_cents"], currency), size=11)
        pdf.text_right(right, y, money(item["amount_cents"], currency), size=11)
        y += 8
        pdf.rule(left, y, right, gray=0.9)

    y += 24
    pdf.text_right(right - 100, y, "Subtotal", size=10, gray=0.35)
    pdf.text_right(right, y, money(record["subtotal_cents"], currency), size=10)

    if record.get("tax_cents"):
        y += 16
        pdf.text_right(right - 100, y, f"Tax ({record['tax_percent']}%)", size=10, gray=0.35)
        pdf.text_right(right, y, money(record["tax_cents"], currency), size=10)

    y += 12
    pdf.rule(right - 220, y, right, width=1.2, gray=0.1)
    y += 22
    pdf.text_right(right - 100, y, "Total", size=14, bold=True)
    pdf.text_right(right, y, money(record["total_cents"], currency), size=14, bold=True)

    if record.get("notes"):
        y += 44
        pdf.rule(left, y - 14, right, gray=0.9)
        for line in str(record["notes"]).splitlines():
            pdf.text(left, y, line, size=10, gray=0.25)
            y += 14

    pdf.text(left, 756, f"Generated by RAPP Second Brain \u00b7 {record['id']}", size=8, gray=0.6)

    path.write_bytes(pdf.build())
    return path


# --------------------------------------------------------------------------
# iCalendar — so a confirmed appointment actually lands on a calendar
#
# RFC 5545. No credentials, no OAuth, no vendor: every calendar app on earth
# reads this, including Google Calendar via a subscription URL.
# --------------------------------------------------------------------------


def _ics_escape(text: Any) -> str:
    return (
        str(text)
        .replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\r\n", "\\n")
        .replace("\n", "\\n")
    )


def _ics_fold(line: str) -> str:
    """RFC 5545 requires lines of at most 75 octets, continued with a space."""
    encoded = line.encode("utf-8")
    if len(encoded) <= 75:
        return line

    chunks, current = [], bytearray()
    for char in line:
        char_bytes = char.encode("utf-8")
        limit = 75 if not chunks else 74  # continuation lines carry a leading space
        if len(current) + len(char_bytes) > limit:
            chunks.append(current.decode("utf-8"))
            current = bytearray()
        current += char_bytes
    chunks.append(current.decode("utf-8"))
    return "\r\n ".join(chunks)


def _ics_time(iso: str | None, *, utc: bool = False) -> str | None:
    if not iso:
        return None
    try:
        parsed = _dt.datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    if utc:
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=_dt.timezone.utc)
        return parsed.astimezone(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return parsed.strftime("%Y%m%dT%H%M%S")


def render_ics(state: dict, *, include_proposed: bool = False) -> str:
    stamp = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        f"PRODID:-//RAPP Second Brain//{SPEC}//EN",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "X-WR-CALNAME:RAPP Second Brain",
    ]

    wanted = {"confirmed"} | ({"proposed"} if include_proposed else set())

    for appointment in sorted(state["appointments"].values(), key=lambda a: a.get("start") or ""):
        if appointment.get("status") not in wanted:
            continue
        start = _ics_time(appointment.get("start"))
        if not start:
            continue

        end = _ics_time(appointment.get("end"))
        if not end:
            try:
                begins = _dt.datetime.fromisoformat(appointment["start"])
                end = (begins + _dt.timedelta(hours=1)).strftime("%Y%m%dT%H%M%S")
            except ValueError:
                end = start

        description = []
        if appointment.get("with"):
            description.append(f"With: {appointment['with']}")
        if appointment.get("notes"):
            description.append(str(appointment["notes"]))
        if appointment.get("call_id"):
            description.append(f"Agreed on call {appointment['call_id']}")

        event = [
            "BEGIN:VEVENT",
            f"UID:{appointment['id']}@rapp-second-brain",
            f"DTSTAMP:{stamp}",
            f"DTSTART:{start}",
            f"DTEND:{end}",
            f"SUMMARY:{_ics_escape(appointment.get('title') or 'Appointment')}",
            f"STATUS:{'CONFIRMED' if appointment['status'] == 'confirmed' else 'TENTATIVE'}",
        ]
        if description:
            event.append(f"DESCRIPTION:{_ics_escape(chr(10).join(description))}")
        if appointment.get("location"):
            event.append(f"LOCATION:{_ics_escape(appointment['location'])}")
        event.append("END:VEVENT")
        lines.extend(event)

    lines.append("END:VCALENDAR")
    return "\r\n".join(_ics_fold(line) for line in lines) + "\r\n"


def cmd_calendar(brain: Brain, args, out: Out) -> int:
    brain.require()
    state = brain.state()
    ics = render_ics(state, include_proposed=args.include_proposed)
    count = ics.count("BEGIN:VEVENT")

    if args.output:
        path = Path(os.path.expanduser(args.output))
    else:
        path = brain.root / "artifacts" / "calendar.ics"
    path.parent.mkdir(parents=True, exist_ok=True)
    # Written as bytes: render_ics already emits CRLF per RFC 5545, and text
    # mode would translate them. (Path.write_text(newline=...) is 3.10+.)
    path.write_bytes(ics.encode("utf-8"))

    out.emit(
        {"ok": True, "path": str(path), "events": count},
        f"Wrote {count} event{'' if count == 1 else 's'} to {path}\n"
        f"  Subscribe to it, or import it into any calendar app.\n"
        f"  Live feed: rsb serve  ->  http://127.0.0.1:7431/calendar.ics",
    )
    return 0


# --------------------------------------------------------------------------
# brief / context — what the assistant should know before it acts
# --------------------------------------------------------------------------


def build_brief(state: dict) -> dict:
    today = _dt.date.today().isoformat()
    upcoming = sorted(
        [a for a in state["appointments"].values() if a["status"] == "confirmed" and (a.get("start") or "") >= today],
        key=lambda a: a.get("start") or "",
    )
    pending = [a for a in state["approvals"].values() if a["status"] == "pending"]
    open_leads = [l for l in state["leads"].values() if l.get("status") not in ("won", "lost")]
    unpaid = [i for i in state["invoices"].values() if i["status"] != "paid"]
    recent_calls = sorted(state["calls"].values(), key=lambda c: c.get("started_at", ""), reverse=True)[:5]
    return {
        "generated_at": now_iso(),
        "owner": state.get("owner"),
        "upcoming_appointments": upcoming[:10],
        "pending_approvals": pending,
        "open_leads": sorted(open_leads, key=lambda l: l.get("value_cents", 0), reverse=True)[:10],
        "unpaid_invoices": unpaid,
        "unpaid_total_cents": sum(i["total_cents"] for i in unpaid),
        "recent_calls": [
            {"id": c["id"], "peer": c.get("contact_name") or c["peer"], "outcome": c.get("outcome"), "when": c.get("started_at")}
            for c in recent_calls
        ],
        "recent_notes": state["notes"][-8:],
        "prefs": state["prefs"],
        "totals": {
            "contacts": len(state["contacts"]),
            "calls": len(state["calls"]),
            "appointments": len(state["appointments"]),
            "leads": len(state["leads"]),
            "invoices": len(state["invoices"]),
        },
    }


def cmd_brief(brain: Brain, args, out: Out) -> int:
    brain.require()
    brief = build_brief(brain.state())
    if out.as_json:
        out.emit(brief)
        return 0

    lines = [f"RAPP Second Brain — brief for {brief['owner'] or 'you'}  ({brief['generated_at']})", ""]

    lines.append("Upcoming")
    lines += [f"  {human_when(a.get('start'))}  {a.get('title')} with {a.get('with')}" for a in brief["upcoming_appointments"]] or ["  (nothing scheduled)"]

    if brief["pending_approvals"]:
        lines += ["", "Waiting on you"]
        lines += [f"  [{a['id']}] {a['subject']}" for a in brief["pending_approvals"]]

    if brief["open_leads"]:
        lines += ["", "Open leads"]
        lines += [f"  {money(l.get('value_cents', 0), l.get('currency', 'USD')):>12}  {l.get('name')} — {l.get('status')}" for l in brief["open_leads"]]

    if brief["unpaid_invoices"]:
        lines += ["", f"Unpaid invoices — {money(brief['unpaid_total_cents'])}"]
        lines += [f"  {i['number']}  {i['bill_to']}  {money(i['total_cents'], i['currency'])}" for i in brief["unpaid_invoices"]]

    if brief["recent_calls"]:
        lines += ["", "Recent calls"]
        lines += [f"  {(c['when'] or '')[:16]}  {c['peer']} — {c['outcome'] or 'in progress'}" for c in brief["recent_calls"]]

    print("\n".join(lines))
    return 0


def cmd_context(brain: Brain, args, out: Out) -> int:
    """Emit a compact block for injection into an LLM system prompt."""
    brain.require()
    state = brain.state()
    brief = build_brief(state)
    parts = ["<second_brain>"]
    if brief["owner"]:
        parts.append(f"owner: {brief['owner']}")
    if state["prefs"]:
        parts.append("preferences:")
        parts += [f"  - {k}: {v}" for k, v in sorted(state["prefs"].items())]
    if brief["upcoming_appointments"]:
        parts.append("upcoming:")
        parts += [f"  - {human_when(a.get('start'))} — {a.get('title')} with {a.get('with')}" for a in brief["upcoming_appointments"][:5]]
    if brief["pending_approvals"]:
        parts.append("awaiting your approval:")
        parts += [f"  - [{a['id']}] {a['subject']}" for a in brief["pending_approvals"]]
    if brief["recent_notes"]:
        parts.append("remembered:")
        parts += [f"  - {n['text']}" for n in brief["recent_notes"]]
    if brief["unpaid_invoices"]:
        parts.append(f"unpaid invoices: {len(brief['unpaid_invoices'])} totalling {money(brief['unpaid_total_cents'])}")
    parts.append("</second_brain>")
    text = "\n".join(parts)
    out.emit({"ok": True, "context": text}, text)
    return 0


def cmd_recall(brain: Brain, args, out: Out) -> int:
    """Full-text search across everything the brain holds."""
    brain.require()
    state = brain.state()
    query = args.query.lower()
    hits: list[dict] = []

    def consider(kind: str, ident: str, label: str, haystack: str, record: Any) -> None:
        if query in haystack.lower():
            hits.append({"kind": kind, "id": ident, "label": label, "record": record})

    for contact in state["contacts"].values():
        consider("contact", contact["id"], contact.get("name", ""), canon(contact), contact)
    for note in state["notes"]:
        consider("note", f"seq:{note['seq']}", note["text"][:70], note["text"] + " " + " ".join(note.get("tags") or []), note)
    for call in state["calls"].values():
        blob = (call.get("objective") or "") + " " + (call.get("summary") or "") + " " + " ".join(t["text"] for t in call.get("turns", []))
        consider("call", call["id"], f"{call.get('contact_name') or call['peer']} — {call.get('outcome', 'in progress')}", blob, call)
    for appointment in state["appointments"].values():
        consider("appointment", appointment["id"], f"{appointment.get('title')} {human_when(appointment.get('start'))}", canon(appointment), appointment)
    for lead in state["leads"].values():
        consider("lead", lead["id"], f"{lead.get('name')} — {lead.get('need', '')[:40]}", canon(lead), lead)
    for bucket, kind in (("quotes", "quote"), ("invoices", "invoice")):
        for record in state[bucket].values():
            consider(kind, record["id"], f"{record['number']} {record['bill_to']}", canon(record), record)

    hits = hits[: args.limit]
    out.emit(
        {"ok": True, "query": args.query, "count": len(hits), "hits": hits},
        "\n".join(f"  {h['kind']:12} {h['label']}  [{h['id']}]" for h in hits) or f"  (nothing matches {args.query!r})",
    )
    return 0 if hits else 1


