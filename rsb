def _doc_record(brain: Brain, args, out: Out, kind: str) -> int:
    """Shared implementation for quote/invoice creation."""
    state = brain.state()
    items, subtotal = line_items(args.item)
    tax_cents = int(round(subtotal * (args.tax or 0) / 100))
    total = subtotal + tax_cents

    lead = None
    if args.lead:
        lead = resolve(state, "leads", args.lead)
    contact = find_contact(state, args.to or (lead or {}).get("contact_id"))

    payload = {
        "id": new_id("q" if kind == "quote" else "inv"),
        "number": args.number or _next_number(state, kind),
        "lead_id": (lead or {}).get("id"),
        "contact_id": (contact or {}).get("id"),
        "bill_to": (contact or {}).get("name") or args.to or (lead or {}).get("name") or "Customer",
        "title": args.title or ("Quote" if kind == "quote" else "Invoice"),
        "items": items,
        "subtotal_cents": subtotal,
        "tax_percent": args.tax or 0,
        "tax_cents": tax_cents,
        "total_cents": total,
        "currency": args.currency,
        "notes": args.notes or "",
        "due": parse_when(args.due) if getattr(args, "due", None) else None,
        "valid_until": parse_when(args.valid_until) if getattr(args, "valid_until", None) else None,
    }
    brain.append(f"{kind}.create", payload, actor=args.actor)

    rendered = None
    if args.render:
        rendered = render_document(brain, payload, kind, args.render)
        brain.append("doc.render", {"ref": payload["id"], "path": str(rendered), "format": args.render}, actor=args.actor)

    text = (
        f"{kind.title()} {payload['number']} ({payload['id']}) for {payload['bill_to']}\n"
        + "\n".join(f"  {i['description']}  x{i['qty']:g}  {money(i['amount_cents'], args.currency)}" for i in items)
        + f"\n  {'-' * 30}\n  total {money(total, args.currency)}"
    )
    if rendered:
        text += f"\n  document: {rendered}"
    out.emit({"ok": True, kind: payload, "document": str(rendered) if rendered else None}, text)
    return 0


def _next_number(state: dict, kind: str) -> str:
    prefix = "Q" if kind == "quote" else "INV"
    year = _dt.date.today().year
    count = len(state["quotes"] if kind == "quote" else state["invoices"]) + 1
    return f"{prefix}-{year}-{count:04d}"


def cmd_quote(brain: Brain, args, out: Out) -> int:
    brain.require()
